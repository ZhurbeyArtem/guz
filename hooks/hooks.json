{
  "description": "Adds the review gate and the writing rules to Claude's context when their options are on.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/review-gate.sh\""
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ste-writing.sh\""
          }
        ]
      }
    ]
  }
}
